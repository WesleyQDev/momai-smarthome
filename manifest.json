                                                                                        "source",
                                                                                        "volume"
                                                                                    ],
                                                                           "description":  "Ação de mídia"
                                                                       },
                                                            "value":  {
                                                                          "type":  "string",
                                                                          "description":  "Valor para ação (ex: volume ou nome da fonte)"
                                                                      }
                                                        }
                                     }
                  },
                  {
                      "name":  "control_climate",
                      "label":  "Controlar Ar Condicionado / Clima",
                      "description":  "Ajusta temperatura alvo e modo de operação do ar condicionado ou termostato.",
                      "parameters":  {
                                         "type":  "object",
                                         "required":  [
                                                          "device_name"
                                                      ],
                                         "properties":  {
