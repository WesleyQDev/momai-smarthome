                                                            "data":  {
                                                                         "type":  "object",
                                                                         "description":  "Dados adicionais em JSON para o serviço"
                                                                     }
                                                        }
                                     }
                  },
                  {
                      "name":  "list_devices",
                      "label":  "Listar Dispositivos",
                      "description":  "Lista todos os dispositivos inteligentes disponíveis com seus estados.",
                      "parameters":  {
                                         "type":  "object",
                                         "properties":  {
                                                            "room":  {
                                                                         "type":  "string",
                                                                         "description":  "Filtrar por cômodo (opcional)"
                                                                     }
                                                        }
                                     }
                  },
                  {
                      "name":  "query_device",
                      "label":  "Consultar Dispositivo",
                      "description":  "Obtém o estado detalhado de um dispositivo específico.",
                      "parameters":  {
                                         "type":  "object",
                                         "required":  [
                                                          "device_name"
                                                      ],
                                         "properties":  {
                                                            "device_name":  {
                                                                                "type":  "string",
                                                                                "description":  "Nome do dispositivo"
                                                                            }
                                                        }
                                     }
                  },
                  {
                      "name":  "open_device_control",
                      "label":  "Abrir Controle Flutuante",
                      "description":  "Abre a interface de controle flutuante (overlay) de um dispositivo específico (TV, luz, ar condicionado, etc).",
                      "parameters":  {
                                         "type":  "object",
                                         "required":  [
                                                          "device_name"
                                                      ],
                                         "properties":  {
                                                            "device_name":  {
                                                                                "type":  "string",
                                                                                "description":  "Nome do dispositivo cujo controle deve ser exibido"
                                                                            }
                                                        }
                                     }
                  },
                  {
                      "name":  "close_device_control",
                      "label":  "Fechar Controle Flutuante",
                      "description":  "Fecha a interface de controle flutuante (overlay) aberta.",
                      "parameters":  {
                                         "type":  "object",
                                         "properties":  {
                                                            "device_name":  {
                                                                                "type":  "string",
                                                                                "description":  "Nome do dispositivo cujo controle fechar (opcional)"
                                                                            },
                                                            "all":  {
                                                                        "type":  "boolean",
                                                                        "description":  "Se true, fecha todos os controles abertos"
                                                                    }
                                                        }
                                     }
                  }
