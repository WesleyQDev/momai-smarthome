                      "parameters":  {
                                         "type":  "object",
                                         "required":  [
                                                          "device_name"
                                                      ],
                                         "properties":  {
                                                            "device_name":  {
                                                                                "type":  "string",
                                                                                "description":  "Nome da lâmpada ou grupo de luzes"
                                                                            },
                                                            "color":  {
                                                                          "type":  "string",
                                                                          "description":  "Nome da cor ou HEX"
                                                                      },
                                                            "brightness":  {
                                                                               "type":  "number",
                                                                               "description":  "Brilho de 0 a 100%"
                                                                           },
                                                            "color_temp":  {
                                                                               "type":  "number",
                                                                               "description":  "Temperatura da cor em Kelvin"
                                                                           }
                                                        }
                                     }
                  },
                  {
                      "name":  "control_tv_remote",
                      "label":  "Controle de TV / Mídia",
                      "description":  "Controle de TV e reprodutores de mídia: comandos de controle remoto, alternância de entrada/fonte e reprodução.",
                      "parameters":  {
                                         "type":  "object",
                                         "required":  [
                                                          "device_name"
                                                      ],
                                         "properties":  {
                                                            "device_name":  {
                                                                                "type":  "string",
                                                                                "description":  "Nome da TV ou Media Player"
                                                                            },
                                                            "command":  {
                                                                            "type":  "string",
                                                                            "description":  "Botão do controle remoto (power, volume_up, mute, etc)"
