    "tools":  [
                  {
                      "name":  "control_device",
                      "label":  "Controlar Dispositivo Inteligente",
                      "description":  "Liga, desliga ou ajusta um dispositivo inteligente (luzes, interruptores, TV, ar condicionado, etc).",
                      "parameters":  {
                                         "type":  "object",
                                         "required":  [
                                                          "device_name",
                                                          "action"
                                                      ],
                                         "properties":  {
                                                            "device_name":  {
                                                                                "type":  "string",
                                                                                "description":  "Nome exato ou parcial do dispositivo"
                                                                            },
                                                            "action":  {
                                                                           "type":  "string",
                                                                           "enum":  [
                                                                                        "on",
                                                                                        "off",
                                                                                        "toggle"
                                                                                    ],
                                                                           "description":  "Ação principal"
                                                                       },
                                                            "brightness":  {
                                                                               "type":  "number",
                                                                               "description":  "Brilho (0-100) para luzes"
                                                                           },
                                                            "color":  {
                                                                          "type":  "string",
                                                                          "description":  "Cor da luz (nome ou HEX)"
                                                                      },
                                                            "color_temp":  {
                                                                               "type":  "number",
                                                                               "description":  "Temperatura da cor em Kelvin"
                                                                           }
                                                        }
                                     }
                  },
                  {
                      "name":  "set_light_color",
                      "label":  "Ajustar Luz / Cor",
